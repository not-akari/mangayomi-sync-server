enum ItemType {
  MANGA
  ANIME
  NOVEL
}

enum Status {
  ONGOING
  COMPLETED
  CANCELED
  UNKNOWN
  ON_HIATUS
  PUBLISHING_FINISHED
}

// A title's shared, scraped facts, one row per (source, link), no matter how many
// accounts have it in their library.
model CatalogEntry {
  id          BigInt   @id @default(autoincrement())
  source      String?
  sourceId    Int?
  link        String?
  itemType    ItemType
  name        String?
  imageUrl    String?
  description String?
  author      String?
  artist      String?
  status      Status   @default(UNKNOWN)
  genre       String[]
  lang        String?
  lastUpdate  BigInt?
  updatedAt   BigInt   @default(0)
  nsfwOverride Boolean?

  mangas   Manga[]
  chapters CatalogChapter[]

  @@unique([source, link])
  @@index([itemType])
}

// A user's library folder.
model Category {
  id           BigInt   @id @default(autoincrement())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     BigInt
  name         String
  forItemType  ItemType
  pos          Int?
  hide         Boolean  @default(false)
  shouldUpdate Boolean  @default(true)
  updatedAt    BigInt   @default(0)

  mangaLinks MangaCategory[]

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
}

// A user's library entry: their relationship to a CatalogEntry, not the title's data
// itself. Two users with the same manga each get one thin row here.
model Manga {
  id                     BigInt       @id @default(autoincrement())
  userId                 String
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId               BigInt
  catalogEntryId         BigInt
  catalogEntry           CatalogEntry @relation(fields: [catalogEntryId], references: [id])
  favorite               Boolean      @default(false)
  dateAdded              BigInt?
  lastRead               BigInt?
  isLocalArchive         Boolean      @default(false)
  customCoverFromTracker String?
  smartUpdateDays        Int?
  updatedAt              BigInt       @default(0)

  categories    MangaCategory[]
  chapterStates ChapterState[]
  tracks        Track[]
  histories     History[]
  updates       Update[]

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
  @@index([catalogEntryId])
}

// Join table between Manga and Category.
model MangaCategory {
  mangaId    BigInt
  manga      Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  categoryId BigInt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([mangaId, categoryId])
}

// A chapter/episode's shared facts, one row per (catalogEntryId, url), no matter how
// many accounts have the parent title.
model CatalogChapter {
  id             BigInt       @id @default(autoincrement())
  catalogEntryId BigInt
  catalogEntry   CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  name           String?
  url            String?
  scanlator      String?
  dateUpload     BigInt?
  isFiller       Boolean      @default(false)
  thumbnailUrl   String?
  description    String?
  downloadSize   Int?
  duration       Int?
  updatedAt      BigInt       @default(0)

  chapterStates ChapterState[]
  updates       Update[]

  @@unique([catalogEntryId, url])
  @@index([catalogEntryId, updatedAt])
}

// A user's read state for one chapter, the only genuinely per-user part of a chapter.
model ChapterState {
  id               BigInt         @id @default(autoincrement())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId         BigInt
  mangaId          BigInt
  manga            Manga          @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  catalogChapterId BigInt
  catalogChapter   CatalogChapter @relation(fields: [catalogChapterId], references: [id])
  isRead           Boolean        @default(false)
  isBookmarked     Boolean        @default(false)
  lastPageRead     String?
  updatedAt        BigInt         @default(0)

  histories History[]

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
  @@index([userId, mangaId])
  @@index([catalogChapterId])
}

enum TrackStatus {
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_READ
  RE_READING
  WATCHING
  PLAN_TO_WATCH
  RE_WATCHING
}

// A user's tracker link (MyAnimeList, AniList, etc.) for one manga.
model Track {
  id                  BigInt      @id @default(autoincrement())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId            BigInt
  mangaId             BigInt
  manga               Manga       @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  syncId              Int?
  mediaId             Int?
  libraryId           Int?
  title               String?
  lastChapterRead     Float?
  totalChapter        Int?
  score               Float?
  status              TrackStatus @default(READING)
  startedReadingDate  String?
  finishedReadingDate String?
  trackingUrl         String?
  itemType            ItemType
  updatedAt           BigInt      @default(0)

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
}

// A user's reading/watching history entry.
model History {
  id                 BigInt       @id @default(autoincrement())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           BigInt
  mangaId            BigInt
  manga              Manga        @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapterStateId     BigInt
  chapterState       ChapterState @relation(fields: [chapterStateId], references: [id], onDelete: Cascade)
  itemType           ItemType
  date               BigInt?
  readingTimeSeconds Int          @default(0)
  updatedAt          BigInt       @default(0)

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
}

// A "new chapter available" notice for a user's manga.
model Update {
  id          BigInt          @id @default(autoincrement())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    BigInt
  mangaId     BigInt
  manga       Manga           @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapterName String?
  chapterId   BigInt?
  chapter     CatalogChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  date        BigInt?
  updatedAt   BigInt          @default(0)

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
  @@index([userId, mangaId, chapterName])
}

enum EntityType {
  CATEGORY
  MANGA
  CHAPTER
  TRACK
  HISTORY
  UPDATE
}

// A deletion marker, so other devices know a row was removed rather than just missing.
model Tombstone {
  id         BigInt     @id @default(autoincrement())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType EntityType
  clientId   BigInt
  deletedAt  BigInt

  @@index([userId, entityType, deletedAt])
}
