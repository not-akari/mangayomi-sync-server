generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AdminScope {
  MANAGE_INVITES
  MANAGE_USERS
  VIEW_LOGS
  MANAGE_SETTINGS
  MANAGE_REPORTS
}

// An account. `username` is the login handle (the wire format still calls it "email");
// `isPrimaryAdmin` marks the permanent bootstrap account that can't be demoted or suspended.
model User {
  id                      String       @id @default(cuid())
  username                String       @unique
  email                   String?      @unique
  passwordHash            String
  role                    Role         @default(USER)
  scopes                  AdminScope[]
  isPrimaryAdmin          Boolean      @default(false)
  createdAt               DateTime     @default(now())
  avatarUrl               String?
  suspended               Boolean      @default(false)
  suspendedReason         String?
  registeredIpHash        String?
  maxLibraryBytesOverride Int?
  blurNsfw                Boolean      @default(false)
  // Base32 secret, stored plain since it must be checked against, not just verified.
  totpSecret          String?
  totpEnabled         Boolean  @default(false)
  totpRecoveryCodeHashes String[] @default([])

  sessions       Session[]
  invitesCreated InviteCode[]      @relation("InvitesCreated")
  invitePresetsCreated InvitePreset[] @relation("InvitePresetsCreated")
  invitedBy      InviteRedemption?
  reports        Report[]
  reportMessages ReportMessage[]
  resetTokens    PasswordResetToken[]
  oauthCodes     OAuthCode[]
  settings       Settings?
  auditLogs      AuditLog[]
  mangas         Manga[]
  categories     Category[]
  chapterStates  ChapterState[]
  tracks         Track[]
  histories      History[]
  updates        Update[]
  tombstones     Tombstone[]

  @@index([username])
}

// One row per logged-in device. `id` is the JWT's `jti`, so `revoked` kills a session
// instantly (logout, ban) without waiting for the token to expire.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
}

// Backs rate limiting, one row per (route, caller) key, in Postgres so limits survive
// restarts and are shared across multiple app instances.
model RateLimitAttempt {
  key           String   @id
  attemptCount  Int      @default(0)
  lastAttemptAt DateTime @default(now())

  @@index([lastAttemptAt])
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  INVITE_CREATED
  INVITE_REVOKED
  ROLE_CHANGED
  SETTINGS_CHANGED
  PASSWORD_CHANGED
  ACCOUNT_DELETED
  ACCOUNT_SUSPENDED
  ACCOUNT_REINSTATED
  PASSWORD_RESET_LINK_CREATED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGED
  AVATAR_CHANGED
  REPORT_CREATED
  REPORT_STATUS_CHANGED
  REPORT_REPLY_CREATED
  SESSION_REVOKED
  CATALOG_NSFW_OVERRIDE_SET
  CATALOG_NSFW_BULK_OVERRIDE_SET
  TOTP_ENABLED
  TOTP_DISABLED
  TOTP_RECOVERY_CODE_USED
}

// Append-only security log. `actorUsername` is a snapshot taken at write time, so
// entries stay readable even after the account is renamed or deleted.
model AuditLog {
  id            String      @id @default(cuid())
  actorId       String?
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorUsername String
  action        AuditAction
  targetId      String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([createdAt])
}

// A registration invite. `grantedRole`/`grantedScopes`/`maxLibraryBytesOverride` apply
// to whoever redeems it.
model InviteCode {
  id            String       @id @default(cuid())
  code          String       @unique
  createdById   String?
  createdBy     User?        @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  maxUses       Int?         @default(1) // null = unlimited
  useCount      Int          @default(0)
  expiresAt     DateTime?
  revoked       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  label         String?
  grantedRole   Role         @default(USER)
  grantedScopes AdminScope[]
  maxLibraryBytesOverride Int?

  redemptions InviteRedemption[]

  @@index([code])
}

// A saved set of invite defaults for the creation form; a UI convenience only, not
// referenced by the invite once created.
model InvitePreset {
  id                      String       @id @default(cuid())
  name                    String       @unique
  maxUses                 Int?         @default(1)
  expiresInDays           Int?
  grantedRole             Role         @default(USER)
  grantedScopes           AdminScope[]
  maxLibraryBytesOverride Int?
  createdById             String?
  createdBy               User?        @relation("InvitePresetsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt               DateTime     @default(now())
}

// One row per redeemed invite, one per account.
model InviteRedemption {
  id           String     @id @default(cuid())
  inviteCodeId String
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id])
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt   DateTime   @default(now())
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  REJECTED
}

// A user-submitted support/abuse note. `userId` is nullable so a locked-out, logged-out
// user can still file one via the typed contact fields.
model Report {
  id              String       @id @default(cuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactUsername String?
  contactInfo     String?
  subject         String
  message         String
  status          ReportStatus @default(PENDING)
  adminNote       String?
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?
  messages        ReportMessage[]

  @@index([status, createdAt])
  @@index([userId])
}

// A message/reply in a report conversation thread.
model ReportMessage {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  isAdmin   Boolean  @default(false)
  message   String
  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
}

// A one-time, expiring, hashed reset link, shared by admin-initiated and self-service
// (email) password resets.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A one-time, expiring, hashed authorization code for the app's OAuth login.
model OAuthCode {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String    @unique
  codeChallenge String
  redirectUri   String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

// One opaque JSON blob per account holding the app's own client-defined preferences;
// the server never interprets what's inside.
model Settings {
  userId    String @id
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt BigInt @default(0)
}

enum RegistrationMode {
  OPEN
  INVITE_ONLY
